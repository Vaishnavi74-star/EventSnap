# EventSnap Frontend Environment Configuration

# Base URL for API Gateway HTTP API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Set to true when connected to live AWS API Gateway + Lambda backend
VITE_USE_REAL_BACKEND=false

# AWS S3 Bucket Name (for reference)
VITE_AWS_S3_BUCKET=eventsnap-photo-storage

# AWS Region
VITE_AWS_REGION=ap-southeast-2

# Amazon Cognito User Pool & Client ID (for admin authentication)
VITE_COGNITO_USER_POOL_ID=ap-southeast-2_example
VITE_COGNITO_CLIENT_ID=exampleclientid12345

